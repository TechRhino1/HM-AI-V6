# HM Algo 2.0 — Environment Configuration Example

# Operational Mode (live | paper)
JARVIS_MODE=live

# Web Terminal Server Settings
JARVIS_PORT=8501
JARVIS_CORS_ORIGIN=*

# Administrative Security
JARVIS_ADMIN_USER=admin
JARVIS_ADMIN_PASS=ChangeThisToStrongPassword123!
JARVIS_TRADER_PASS=
JARVIS_DEMO_PASS=
JARVIS_SECRET_KEY=

# Trading & Risk Caps
JARVIS_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,BTCUSD
JARVIS_MAX_RISK_PCT=0.5
JARVIS_MAX_DAILY_LOSS_PCT=4.0

# AI layer (briefs, explanations, copilot, Overview insights). Set ONE key; without it the UI shows "AI offline"
# and falls back to rule-based text. Gemini needs no extra package; Claude needs `pip install anthropic`.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider (gemini | claude) when both keys are set
JARVIS_AI_PROVIDER=

# Trade Style AUTO: unset/0 = shadow (picks + news checks logged, trading runs as ALL); 1 = AUTO's picks trade
JARVIS_AUTO_STYLE_LIVE=
